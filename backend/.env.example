# AegisAI Backend Environment Configuration Example

# Application Settings
APP_NAME="AegisAI Enterprise Platform"
DEBUG=True
API_PREFIX="/api/v1"

# Database & Cache Settings
DATABASE_URL="postgresql+asyncpg://postgres:secure_password_123@localhost:5434/aegisai_db"
REDIS_URL="redis://:redis_password_123@localhost:6379/0"
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"

# Storage Settings
UPLOAD_DIR="storage/documents"
CHROMA_DB_DIR="storage/chromadb"

# Vector Database Provider ("chroma" or "pinecone")
VECTOR_DB_PROVIDER="chroma"
PINECONE_API_KEY="your_pinecone_api_key"
PINECONE_INDEX_NAME="aegisai-index"

# AI Models (OpenAI)
OPENAI_API_KEY="your_openai_api_key"

# JWT Security
JWT_SECRET_KEY="generate_random_jwt_access_secret"
JWT_REFRESH_SECRET_KEY="generate_random_jwt_refresh_secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
